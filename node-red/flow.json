  {
    "id": "5166fea88412e00c",
    "type": "function",
    "z": "e96df431cbedabc0",
    "name": "Extract&Transform",
    "func": "//Assign properties of msg.payload to variables \nvar sensorv = msg.payload.v   \nsensorv = sensorv/10 \nvar relay= msg.payload.r\n//Extract info from msg.topic \nvar result  = msg.topic.split(\"/\")  //split string to array \n//Form New msg.payload as a JSON array \nmsg.payload = [{    \n    \"sensorv\": sensorv,\n    \"relayState\":relay\n\n}, \n{ \n    //element 2 > Tags \n\"clientid\": result[1], //2nd element of result \n\"device\": result[2]    \n//3rd element of result      \n}];   \nreturn msg; \n",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
