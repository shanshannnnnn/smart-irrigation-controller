    "z": "e96df431cbedabc0",
    "name": "powermode",
    "func": "//create downlink publish topic from received uplink topic \nmsg.topic = \"DL/\" + msg.topic \n//Threshold comparison; create new msg.payload \nif (msg.payload[0].vbat >= 90) { \nmsg.payload = \"HI\"  \n} \nelse { \nmsg.payload = \"LO\" \n} \nreturn msg;",
